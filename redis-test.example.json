    "checks": []
  },
  "authentication": {
    "mode": "prompt",
    "username": null,
    "password_env": "REDIS_PASSWORD",
    "required": true
  },
  "execution": {
    "profile": "standard",
    "suites": null,
    "namespace": "zhuque:redis-test",
    "cleanup": "always",
    "ttl_seconds": 3
  },
  "expectations": {
    "architecture": "master-slave",
    "version_prefix": "4.",
