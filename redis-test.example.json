{
  "connection": {
    "host": "10.0.0.17",
    "port": 6379,
    "db": 0,
    "ssl": false,
    "ssl_cert_reqs": "required",
    "ssl_ca_certs": null,
    "ssl_certfile": null,
    "ssl_keyfile": null,
    "ssl_check_hostname": true,
    "client_name": "redis-instance-tester",
    "socket_connect_timeout": 5.0,
    "socket_timeout": 5.0,
    "retry_attempts": 3,
    "retry_backoff_seconds": 0.25
  },
  "security_group": {
    "probe_timeout_seconds": 2.0,
